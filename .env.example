# Copy to .env to override defaults. Everything is optional.

# Daily ingestion times, UTC, comma separated (HH:MM).
# FUC_SCHEDULE_TIMES_UTC=06:15,18:15

# Ingest at startup when today's snapshot is missing.
# FUC_RUN_ON_STARTUP=true

# Turn the scheduler off completely (manual runs only).
# FUC_SCHEDULER_ENABLED=true

# Source locations.
# FUC_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# FUC_EPSS_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
# FUC_EPSS_DATED_URL=https://epss.empiricalsecurity.com/epss_scores-{date}.csv.gz
